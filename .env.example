# Подключение к PostgreSQL (БД будет создана командой `make db-create`)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/salary
# Секрет подписи JWT — сгенерируйте: make secret
JWT_SECRET=change-me
JWT_TTL_MINUTES=60
# Администратор, создаваемый при старте/`make create-admin`
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
